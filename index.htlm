html <!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" />  <title>BAST BEST</title>  <link rel="preconnect" href="https://fonts.googleapis.com"> <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">  <style>  *{ margin:0; padding:0; box-sizing:border-box; font-family:'Poppins',sans-serif; scroll-behavior:smooth; }  body{ background: radial-gradient(circle at top,#2b001f 0%,#000 50%,#120000 100%); color:white; overflow-x:hidden; }  /* ANIMATED BACKGROUND */  .bg-animation{ position:fixed; width:100%; height:100%; top:0; left:0; overflow:hidden; z-index:-1; }  .bg-animation span{ position:absolute; display:block; width:20px; height:20px; background:rgba(255,215,0,0.15); animation:animate 20s linear infinite; bottom:-150px; border-radius:50%; box-shadow:0 0 20px gold; }  .bg-animation span:nth-child(1){ left:10%; width:80px; height:80px; animation-duration:25s; }  .bg-animation span:nth-child(2){ left:20%; width:20px; height:20px; animation-duration:12s; }  .bg-animation span:nth-child(3){ left:70%; width:30px; height:30px; animation-duration:18s; }  .bg-animation span:nth-child(4){ left:40%; width:60px; height:60px; animation-duration:22s; }  .bg-animation span:nth-child(5){ left:85%; width:25px; height:25px; animation-duration:15s; }  @keyframes animate{ 0%{ transform:translateY(0) rotate(0deg); opacity:0; } 10%{ opacity:1; } 100%{ transform:translateY(-1200px) rotate(720deg); opacity:0; } }  /* CONTAINER */  .container{ width:90%; max-width:1200px; margin:auto; padding:40px 0; }  /* HERO */  .hero{ text-align:center; padding-top:50px; animation:fadeIn 2s ease; }  .logo{ width:320px; max-width:90%; filter: drop-shadow(0 0 20px gold) drop-shadow(0 0 40px rgba(255,215,0,.5)); animation:float 4s ease-in-out infinite; }  .hero h1{ font-size:80px; font-weight:800; margin-top:20px; background:linear-gradient(to right,gold,white,#ff4d4d); -webkit-background-clip:text; color:transparent; text-shadow:0 0 30px rgba(255,215,0,.5); }  .hero p{ margin-top:15px; font-size:18px; color:#ccc; }  /* BUTTON */  .buttons{ margin-top:35px; display:flex; justify-content:center; gap:20px; flex-wrap:wrap; }  .btn{ padding:16px 35px; border-radius:18px; text-decoration:none; font-weight:600; transition:.3s; position:relative; overflow:hidden; }  .btn-wa{ background:linear-gradient(to right,#00b712,#5aff75); color:white; box-shadow:0 0 25px rgba(0,255,100,.5); }  .btn-wa:hover{ transform:translateY(-5px) scale(1.05); box-shadow:0 0 40px rgba(0,255,100,.8); }  .btn-price{ background:linear-gradient(to right,gold,#ffcc00); color:black; box-shadow:0 0 25px rgba(255,215,0,.5); }  .btn-price:hover{ transform:translateY(-5px) scale(1.05); }  /* SEARCH */  .search-box{ margin-top:60px; display:flex; justify-content:center; }  .search-box input{ width:100%; max-width:500px; padding:18px 25px; border:none; border-radius:20px; background:rgba(255,255,255,.08); backdrop-filter:blur(10px); color:white; font-size:16px; outline:none; border:1px solid rgba(255,215,0,.2); box-shadow:0 0 20px rgba(255,215,0,.1); }  /* SECTION TITLE */  .section-title{ margin-top:80px; margin-bottom:30px; font-size:40px; text-align:center; font-weight:700; background:linear-gradient(to right,gold,white); -webkit-background-clip:text; color:transparent; }  /* CARDS */  .cards{ display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:25px; }  .card{ background:rgba(255,255,255,.05); backdrop-filter:blur(15px); border:1px solid rgba(255,215,0,.2); padding:30px; border-radius:28px; transition:.4s; position:relative; overflow:hidden; }  .card::before{ content:""; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:linear-gradient( 45deg, transparent, rgba(255,215,0,.08), transparent ); transform:rotate(25deg); animation:shine 5s linear infinite; }  .card:hover{ transform:translateY(-12px) scale(1.02); box-shadow: 0 0 30px rgba(255,215,0,.2), 0 0 60px rgba(255,0,100,.15); }  .card h2{ margin-bottom:20px; font-size:28px; color:gold; position:relative; z-index:1; }  .card p{ margin:12px 0; color:#eee; position:relative; z-index:1; }  /* QRIS */  .qris-section{ margin-top:100px; text-align:center; }  .qris-box{ margin-top:30px; display:inline-block; padding:20px; border-radius:30px; background:rgba(255,255,255,.05); border:1px solid rgba(255,215,0,.3); backdrop-filter:blur(15px); box-shadow:0 0 40px rgba(255,215,0,.15); }  .qris-box img{ width:350px; max-width:100%; border-radius:20px; }  /* FOOTER */  footer{ margin-top:100px; padding:40px 20px; text-align:center; border-top:1px solid rgba(255,255,255,.1); color:#888; }  /* ANIMATION */  @keyframes float{ 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(-15px); } }  @keyframes fadeIn{ from{ opacity:0; transform:translateY(40px); } to{ opacity:1; transform:translateY(0); } }  @keyframes shine{ 0%{ transform:translateX(-100%) rotate(25deg); } 100%{ transform:translateX(100%) rotate(25deg); } }  /* MOBILE */  @media(max-width:768px){  .hero h1{ font-size:50px; }  .section-title{ font-size:30px; }  .logo{ width:240px; }  }  </style> </head>  <body>  <div class="bg-animation"> <span></span> <span></span> <span></span> <span></span> <span></span> </div>  <div class="container">  <!-- HERO -->  <div class="hero">  <img class="logo" src="https://i.imgur.com/8Km9tLL.png" />  <h1>BAST BEST</h1>  <p> Premium Luxury Digital Store </p>  <div class="buttons">  <a href="https://bit.ly/BASTBEST" target="_blank" class="btn btn-wa" > Chat WhatsApp </a>  <a href="#pricing" class="btn btn-price" > Lihat Pricelist </a>  </div>  </div>  <!-- SEARCH -->  <div class="search-box">  <input type="text" placeholder="Cari produk favorit kamu..." >  </div>  <!-- PRICELIST -->  <h2 class="section-title" id="pricing"> PREMIUM PRODUCTS </h2>  <div class="cards">  <div class="card"> <h2>STREAMING</h2> <p>Netflix — 25K</p> <p>Spotify — 25K</p> <p>YouTube Premium — 20K</p> <p>Disney+ — 30K</p> <p>Vidio — 35K</p> </div>  <div class="card"> <h2>EDITING</h2> <p>Canva Pro — 30K</p> <p>CapCut — 20K</p> <p>Remini — 15K</p> <p>Meitu — 45K</p> <p>Picsart — 20K</p> </div>  <div class="card"> <h2>AI TOOLS</h2> <p>ChatGPT Plus — 45K</p> <p>Claude AI — 60K</p> <p>Gemini — 15K</p> <p>Grammarly — 15K</p> <p>MS 365 — 25K</p> </div>  <div class="card"> <h2>ANIME & MOVIE</h2> <p>Crunchyroll — 25K</p> <p>LokLok — 20K</p> <p>DramaBox — 20K</p> <p>Wetv — 30K</p> <p>VIU — 20K</p> </div>  </div>  <!-- QRIS -->  <div class="qris-section">  <h2 class="section-title"> QRIS PAYMENT </h2>  <div class="qris-box">  <img src="https://i.imgur.com/Z8bK0sK.jpeg" />  </div>  </div>  <!-- FOOTER -->  <footer>  <p>© 2026 BAST BEST</p>  <p style="margin-top:10px;"> Luxury Premium Digital Store </p>  </footer>  </div>  </body> </html> 
